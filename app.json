{
  "expo": {
    "name": "Apartag",
    "slug": "apartag",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apartag",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.apartag.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "es",
        "NFCReaderUsageDescription": "Apartag usa NFC para bloquear y desbloquear las apps que elijas al acercar tu tag."
      },
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.apartag.app"
        ]
      }
    },
    "android": {
      "package": "com.apartag.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B0A09",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC",
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0A09",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Apartag usa la cámara para leer el QR de la llave móvil.",
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Apartag usa NFC para bloquear y desbloquear las apps que elijas al acercar tu tag.",
          "includeNdefEntitlement": true
        }
      ],
      [
        "expo-app-blocker",
        {
          "ios": {
            "appGroup": "group.com.apartag.app",
            "shield": {
              "title": "Estás en Apartag",
              "subtitle": "{appName} está bloqueada. Ve a por tu llave.",
              "primaryButtonLabel": "Volver a Apartag",
              "secondaryButtonLabel": null,
              "primaryButtonColor": "#D4923A",
              "titleColor": "#F7F1E8",
              "subtitleColor": "#9C8F7E",
              "backgroundColor": "#0B0A09",
              "backgroundBlurStyle": "systemThickMaterialDark",
              "tempUnlockTitle": "Ya casi",
              "tempUnlockSubtitle": "Se está abriendo. Prueba otra vez en un momento.",
              "tempUnlockButtonLabel": "OK",
              "countSuffix": " Tienes {count} apps bloqueadas."
            },
            "notification": {
              "title": "Apartag",
              "body": "Toca para volver a Apartag."
            }
          },
          "android": {
            "scheme": "apartag",
            "overlayTitle": "Estás en Apartag",
            "overlayText": "{appName} está bloqueada. Ve a por tu llave.",
            "overlayBackgroundColor": "#0B0A09",
            "overlayTitleColor": "#F7F1E8",
            "overlayTextColor": "#9C8F7E",
            "notificationTitle": "Apartag",
            "notificationText": "{appName} está bloqueada. Acerca el tag."
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["es", "en"],
            "android": ["es", "en"]
          }
        }
      ],
      "expo-iap",
      "./plugins/with-shield-locales"
    ],
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.apartag.app.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.apartag.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.apartag.app.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.apartag.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.apartag.app.DeviceActivityMonitor",
                  "targetName": "DeviceActivityMonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.apartag.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "58a7bafd-e180-4240-a594-9f17bc2ae327"
      }
    },
    "owner": "jhotaota"
  }
}
